# Plantilla de configuración. Cópiala como .env y completa los valores.
# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=reemplazar-por-una-clave-generada

# True solo en desarrollo. En producción debe ser False.
DJANGO_DEBUG=True

# Hosts autorizados, separados por coma.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos. "postgres" (por defecto) o "sqlite" (respaldo sin instalar nada).
DB_ENGINE=postgres
DB_NAME=skillia
DB_USER=skillia
DB_PASSWORD=reemplazar-por-la-clave-del-usuario
DB_HOST=localhost
DB_PORT=5432

# Solo Windows, opcional: carpeta bin de PostgreSQL. Si se deja vacía se detecta sola
# en C:\Program Files\PostgreSQL\<versión>\bin.
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
